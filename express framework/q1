const users = [
  { id: 1, name: "Amit" },
  { id: 2, name: "Rahul" },
  { id: 3, name: "Sneha" }
];

app.get('/users', (req, res) => {
  const { name } = req.query;

  if (!name) {
    return res.json(users);
  }

  const filtered = users.filter(user =>
    user.name.toLowerCase().includes(name.toLowerCase())
  );

  res.json(filtered);
});
